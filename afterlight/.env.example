# Copy to .env.local to override. Nothing here is secret; never put credentials in VITE_ variables,
# because every VITE_ value is compiled into the public client bundle.

# Platform adapter: "crazygames" loads the CrazyGames HTML5 SDK v3, "none" runs without any platform SDK.
# Defaults: "none" for `npm run dev`, "crazygames" for `npm run build` (see .env.development/.env.production).
VITE_PLATFORM=none
