{
  "name": "afterlight-blackout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AFTERLIGHT: BLACKOUT — an original browser FPS (client). Milestone 1: foundation.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
