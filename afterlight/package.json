    "test": "vitest run",
    "package": "node scripts/package.mjs",
    "smoke": "node scripts/smoke.mjs && node scripts/lock-probe.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "fflate": "^0.8.3",
    "puppeteer-core": "^25.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
